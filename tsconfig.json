{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@env": ["env.ts"],
      "@mongrov/types": ["./node_modules/@mongrov/types"],
      "@mongrov/types/*": ["./node_modules/@mongrov/types/*"]
    },
    "checkJs": true,
    "strict": true,
    "esModuleInterop": true
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "nativewind-env.d.ts",
    "env.ts"
  ],
  "exclude": [
    "node_modules",
    "babel.config.js",
    "metro.config.js",
    "docs",
    "cli",
    "android",
    "ios",
    "lint-staged.config.js",
    "src/lib/rxdb/rxdb-premium",
    "vendor"
  ]
}
